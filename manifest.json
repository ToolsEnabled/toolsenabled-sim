{
  "manifest_version": "0.3",
  "name": "toolsenabled-sim",
  "display_name": "ToolsEnabled Sim",
  "version": "0.1.2",
  "description": "Deterministic offline warehouse robot simulation with shared MCP control, delivery guidance and replay.",
  "author": {
    "name": "ToolsEnabled, Inc.",
    "email": "support@toolsenabled.ai",
    "url": "https://toolsenabled.ai"
  },
  "homepage": "https://toolsenabled.ai",
  "documentation": "https://github.com/ToolsEnabled/toolsenabled-sim#readme",
  "support": "mailto:support@toolsenabled.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/ToolsEnabled/toolsenabled-sim"
  },
  "license": "MIT",
  "privacy_policies": [
    "https://toolsenabled.ai/legal/privacy/"
  ],
  "server": {
    "type": "node",
    "entry_point": "src/mcp.mjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/src/mcp.mjs"
      ],
      "env": {
        "SIM_CONNECTION": "${user_config.connection_file}"
      }
    }
  },
  "user_config": {
    "connection_file": {
      "type": "file",
      "title": "Assigned robot connection file",
      "description": "Absolute path to the private connection file created by the running Sim hub for this agent. Keep the hub outside the plugin cache.",
      "required": true
    }
  },
  "compatibility": {
    "platforms": [
      "darwin"
    ],
    "runtimes": {
      "node": ">=22"
    }
  }
}
