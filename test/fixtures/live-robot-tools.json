          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$",
          "minLength": 1,
          "maxLength": 48
        },
        "x": {
          "type": "number",
          "minimum": -30,
          "maximum": 30
        },
        "y": {
          "type": "number",
          "minimum": -30,
          "maximum": 30
        },
        "round": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$",
          "maxLength": 32
