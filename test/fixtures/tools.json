        },
        "crateId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$",
          "minLength": 1,
          "maxLength": 48
        },
        "round": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$",
          "maxLength": 32
        }
      },
      "required": [
        "robotId",
        "crateId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
